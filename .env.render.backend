# Copy and paste these into the Render Dashboard -> Backend Service -> Environment Variables

NODE_ENV=production

# Replace this with the URL you get after deploying the AI layer to Render
AI_LAYER_URL=https://your-ai-layer-url.onrender.com

# Replace with your frontend's Vercel URL (e.g. for CORS)
FRONTEND_URL=https://your-frontend-url.vercel.app

# API Keys
GROQ_API_KEY=your-groq-api-key-here
LANGCHAIN_API_KEY=your-langchain-key-if-used
